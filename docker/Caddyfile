{
	admin off
}

# CONEX_TLS=auto: Caddy's default, see below. internal: always the local CA.
(tls-auto) {
}
(tls-internal) {
	tls internal
}

# HTTPS for CONEX_HOST; plain HTTP on :80 redirects here. Certificates come
# from Let's Encrypt for public domains, and from Caddy's local CA for
# localhost, IPs and *.local / *.internal / *.home.arpa names.
{$CONEX_HOST:localhost} {
	import tls-{$CONEX_TLS:auto}
	encode zstd gzip

	# API: strip the /api prefix, like the vite dev proxy does.
	handle_path /api/* {
		reverse_proxy {$CONEX_API_UPSTREAM}
	}

	# Hashed build assets can be cached forever.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# SPA with history routing: unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}
