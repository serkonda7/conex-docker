# conex API settings. Rendered into config.toml by docker/entrypoint.sh.

# Secret for signing session JWTs (min. 32 chars). Generate one with:
#   openssl rand -hex 48
# Left empty, a key is generated on first start and kept in the data volume.
CONEX_APP_KEY=
# Alternative: read the key from a file (e.g. a Docker secret).
# CONEX_APP_KEY_FILE=/run/secrets/conex_app_key

# Keep true behind HTTPS. The default setup serves plain HTTP, where browsers
# drop secure cookies, so login only works with false.
CONEX_SECURE_COOKIES=false

# Public URL of the UI, e.g. https://conex.example.com
CONEX_FRONTEND_URL=

# Login rate limit per client.
CONEX_LOGIN_MAX_ATTEMPTS=10
CONEX_LOGIN_WINDOW_SECONDS=300

# Bump to invalidate all existing sessions.
CONEX_JWT_KEY_VERSION=1

# Use your own config file instead of the env vars above (mount it in).
# CONEX_CONFIG_PATH=/etc/conex/config.toml
