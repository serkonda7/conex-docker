# Optional AGFEO Dashboard LDAP service (agfeo-ldap profile). All options:
# docs/integrations/agfeo.md in conex. The conex URL and the container port
# (1389) are preset in the image.
# Search base the Dashboard is configured with.
AGFEO_LDAP_BASE_DN=ou=contacts,dc=conex
# LDAPS: set both to PEM files mounted into the container.
#AGFEO_LDAP_TLS_CERT=/etc/agfeo-ldap/cert.pem
#AGFEO_LDAP_TLS_KEY=/etc/agfeo-ldap/key.pem
# 1 logs every search.
#AGFEO_LDAP_DEBUG=1
