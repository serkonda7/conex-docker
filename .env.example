# Deployment settings. Copy to .env (gitignored); docker compose reads it.

# Database password, set once before the first start; Postgres only applies
# it when its volume is created. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Hostname the UI is served at over HTTPS. A public domain gets a Let's
# Encrypt certificate (ports 80 and 443 must be reachable); localhost, IPs and
# *.local / *.internal / *.home.arpa names get one from Caddy's local CA.
CONEX_HOST=localhost

# Images: conex version to build, and image name and tag.
#CONEX_VERSION=main
#CONEX_IMAGE=conex
#CONEX_TAG=latest

# Optional AGFEO Dashboard LDAP service. All options: docs/integrations/agfeo.md
# in conex.
#COMPOSE_PROFILES=agfeo-ldap
#AGFEO_LDAP_BASE_DN=ou=contacts,dc=conex
# LDAPS: PEM files mounted into the container (see the override example).
#AGFEO_LDAP_TLS_CERT=/etc/agfeo-ldap/cert.pem
#AGFEO_LDAP_TLS_KEY=/etc/agfeo-ldap/key.pem
# 1 logs every search.
#AGFEO_LDAP_DEBUG=1
