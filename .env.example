# Copy to .env (gitignored); read by docker compose.

# Only applied when the database volume is created. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Public domain, localhost, IPs, *.local, etc.
CONEX_HOST=conex.mydomain.com
# Defaults to Let's Encrypt for public domains. Uncomment to enforce Caddy's local CA.
#CONEX_TLS=internal

# `stable` (latest release), branch name or tag. See README for details (https://github.com/cns/conex#version)
CONEX_VERSION=stable
#CONEX_IMAGE=conex

# AGFEO Dashboard LDAP, see docs/integrations/agfeo.md in conex.
#COMPOSE_PROFILES=agfeo-ldap
#AGFEO_LDAP_BASE_DN=ou=contacts,dc=conex
#AGFEO_LDAP_TLS_CERT=/etc/agfeo-ldap/cert.pem
#AGFEO_LDAP_TLS_KEY=/etc/agfeo-ldap/key.pem
#AGFEO_LDAP_DEBUG=1
